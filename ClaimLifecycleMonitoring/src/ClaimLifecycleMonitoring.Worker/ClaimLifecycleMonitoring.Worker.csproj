    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaimLifecycleMonitoring.Application\ClaimLifecycleMonitoring.Application.csproj" />
    <ProjectReference Include="..\ClaimLifecycleMonitoring.Domain\ClaimLifecycleMonitoring.Domain.csproj" />
    <ProjectReference Include="..\ClaimLifecycleMonitoring.Infrastructure\ClaimLifecycleMonitoring.Infrastructure.csproj" />
    <ProjectReference Include="..\ClaimLifecycleMonitoring.Persistence\ClaimLifecycleMonitoring.Persistence.csproj" />
  </ItemGroup>
</Project>
