{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ClaimLifecycleDb": ""
  },
  "Persistence": {
    "UseInMemory": "true"
  },
  "Monitoring": {
    "ScanIntervalSeconds": 60,
    "BatchSize": 500,
    "DefaultStageSlaHours": 24,
    "GlobalClaimTimeoutHours": 720,
    "Expected999Hours": 24,
    "Expected277CaHours": 72,
    "Expected835Hours": 720
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  }
}
